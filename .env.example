# Скопируй в .env ТОЛЬКО если локальная БД Cursor недоступна.
# Основной (безопасный) путь — читать токен из %APPDATA%\Cursor\...\state.vscdb.
# Никогда не коммить .env.

# Полный WorkosCursorSessionToken (userId::accessToken или url-encoded)
# CURSOR_SESSION_TOKEN=

# Или по отдельности:
# CURSOR_USER_ID=user_xxxxxxxx
# CURSOR_ACCESS_TOKEN=eyJ...

# Интервал polling (сек). Живого stream у Cursor нет. Дефолт 60.
# CURSOR_LIMITS_REFRESH_SEC=60

# Показать окно деталей сразу при старте
# CURSOR_LIMITS_SHOW_POPUP=0
